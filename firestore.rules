rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId));
    }
    function isMember(classId) {
      return signedIn() && request.auth.uid in classDoc(classId).data.memberIds;
    }
    function isTeacher(classId) {
      return signedIn() && classDoc(classId).data.teacherUid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role in ['student', 'teacher'];
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['name', 'photoUrl', 'quizScores', 'topicMastery']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && userDoc().data.role == 'teacher' &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && (
        resource.data.teacherUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['memberIds']) &&
         !(request.auth.uid in resource.data.memberIds) &&
         request.auth.uid in request.resource.data.memberIds &&
         request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
         request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1) ||
        (request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['memberIds']) &&
         request.auth.uid in resource.data.memberIds &&
         resource.data.teacherUid != request.auth.uid &&
         !(request.auth.uid in request.resource.data.memberIds) &&
         resource.data.memberIds.hasAll(request.resource.data.memberIds) &&
         request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
      );
      allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isMember(classId);
        allow create: if signedIn() && memberUid == request.auth.uid &&
          request.auth.uid in getAfter(
            /databases/$(database)/documents/classes/$(classId)
          ).data.memberIds;
        allow update: if false;
        allow delete: if isTeacher(classId) ||
          (signedIn() && memberUid == request.auth.uid && isMember(classId));
      }

      match /posts/{postId} {
        allow read: if isMember(classId) || isTeacher(classId);
        allow create: if isTeacher(classId) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.type in ['homework', 'announcement'];
        allow update, delete: if isTeacher(classId);

        match /comments/{commentId} {
          allow read: if isMember(classId) || isTeacher(classId);
          allow create: if (isMember(classId) || isTeacher(classId)) &&
            request.resource.data.authorUid == request.auth.uid;
          allow update: if (isMember(classId) || isTeacher(classId)) &&
            resource.data.authorUid == request.auth.uid &&
            request.resource.data.authorUid == resource.data.authorUid &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['body', 'editedAt']);
          allow delete: if isTeacher(classId) ||
            (isMember(classId) && resource.data.authorUid == request.auth.uid);
        }

        match /submissions/{studentUid} {
          allow get: if isTeacher(classId) ||
            (isMember(classId) && studentUid == request.auth.uid);
          allow list: if isTeacher(classId) ||
            (isMember(classId) && resource.data.studentUid == request.auth.uid);
          allow create: if isMember(classId) &&
            studentUid == request.auth.uid &&
            request.resource.data.studentUid == request.auth.uid &&
            request.resource.data.status == 'submitted' &&
            get(/databases/$(database)/documents/classes/$(classId)/posts/$(postId)).data.type == 'homework';
          allow update: if (isTeacher(classId) &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'reviewedAt']) &&
            request.resource.data.status == 'accepted') ||
            (isMember(classId) && studentUid == request.auth.uid &&
            request.resource.data.studentUid == resource.data.studentUid &&
            request.resource.data.status == 'submitted' &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['body', 'studentName', 'status', 'submittedAt']));
          allow delete: if isTeacher(classId) ||
            (isMember(classId) && studentUid == request.auth.uid);
        }
      }
    }
  }
}
